#!/usr/bin/env python3
"""Builds quickshell/assets/emoji.json, the launcher's emoji and symbols, from
Unicode CLDR's English annotations (unicode-cldr-annotations, Unicode License
v3, see NOTICE):  build-emoji [path to annotations/en.xml]

Each entry: [character, name, keywords joined by " | "]. Skin-tone modifiers
alone are left out (they're picked in the sequences that use them)."""
import json
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

src = sys.argv[1] if len(sys.argv) > 1 else "/usr/share/unicode/cldr/common/annotations/en.xml"
names, keys = {}, {}
for a in ET.parse(src).getroot().iter("annotation"):
    cp = a.get("cp")
    if a.get("type") == "tts":
        names[cp] = a.text
    else:
        keys[cp] = a.text
out = []
for cp, name in names.items():
    if cp in "\U0001F3FB\U0001F3FC\U0001F3FD\U0001F3FE\U0001F3FF":
        continue
    kw = [k for k in (keys.get(cp) or "").split(" | ") if k and k.lower() not in name.lower()]
    out.append([cp, name, " | ".join(kw)])
dest = Path(__file__).resolve().parent.parent / "quickshell/assets/emoji.json"
dest.write_text(json.dumps(out, ensure_ascii=False, separators=(",", ":")) + "\n", encoding="utf8")
print(f"{len(out)} entries, {dest.stat().st_size // 1024} KB -> {dest}")
