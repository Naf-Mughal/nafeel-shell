#!/usr/bin/env python3
"""Reads bin/prim-cycle's marks and the present log: per primitive fired, the
frame window's frames over the next few seconds, and where a frame was shown
twice or skipped while the animation clock ran (msc+N with N>1 inside a
run of frames, or an uneven animation step). prim-cycle-report [log] [marks]"""
import os, sys
rt = os.environ.get('XDG_RUNTIME_DIR', '/tmp')
log = sys.argv[1] if len(sys.argv) > 1 else os.path.join(rt, 'present.log')
marks = sys.argv[2] if len(sys.argv) > 2 else os.path.join(rt, 'prim-marks')
F = sorted((int(p[1]), int(p[2]), int(p[3])) for p in (l.split() for l in open(log)) if p and p[0] == 'F')
M = [(int(a), b) for a, b in (l.split(None, 1) for l in open(marks))]
bad_total = 0
for i, (t, name) in enumerate(M):
    name = name.strip()
    if name == 'END':
        continue
    end = M[i + 1][0] if i + 1 < len(M) else t + 4e9
    fr = [f for f in F if t <= f[0] < end]
    bad = []
    for a, b in zip(fr, fr[1:]):
        dm = b[1] - a[1]; da = b[2] - a[2]
        if dm > 6 or da > 200 or da == 0:
            continue  # a pause between motions, or a still redraw: not a drop
        if dm != 1 or not (12 <= da <= 21):
            bad.append(f"{(b[0]-t)/1e6:.0f}ms:msc+{dm},anim+{da}")
    bad_total += bool(bad)
    print(f"{name:10s} {len(fr):4d}f {bad[:6]}")
print("firings with a dropped/irregular frame:", bad_total, "of", sum(1 for _, n in M if n.strip() != 'END'))
