#!/bin/sh
# Runs and supervises the shell. umbriel autostarts it ([general] autostart)
# since the cut-over from Noctalia (N7). One instance per session (see below). Quickshell's own output goes to
# $XDG_RUNTIME_DIR/nafeel-shell.log.

root=$(dirname "$(dirname "$(readlink -f "$0")")")
run=${XDG_RUNTIME_DIR:-/tmp}

# One shell per session: wait a moment for one that's going away rather than
# give up. Asked of Quickshell itself (a shell it restarted after a crash
# runs under a different command line). Not a lock file: apps the shell
# launches would inherit and hold its descriptor.
# (No Quickshell at all, as at login: no need to ask, which takes ~0.2 s.)
running() {
    pgrep -u "$(id -u)" -x quickshell >/dev/null || pgrep -u "$(id -u)" -x .quickshell-wrapped >/dev/null || return 1
    qs list --all 2>/dev/null | grep -q "Config path: $root/quickshell/shell.qml"
}
for _ in $(seq 30); do
    running || break
    sleep 0.5
done
if running; then
    echo "another shell is still running"
    exit 0
fi

# The native QML module (native/, "Nafeel"): build it on first start.
if [ ! -f "$root/native/build/qml/Nafeel/qmldir" ]; then
    echo "building the native module"
    "$root/native/build.sh" >"$run/nafeel-shell-build.log" 2>&1 || echo "native module build failed (see $run/nafeel-shell-build.log)"
fi

# Quickshell restarts itself after a crash, except within 10 s of starting;
# this loop covers that case too, backing off so a broken config can't spin.
# Plugin folders become Quickshell modules (their files then use each other
# by name) only if the shell imports them at startup: list them all in
# quickshell/PluginModules.qml, which shell.qml loads. A plugin that's off is
# registered but nothing in it is made.
plugin_modules() {
    out="$root/quickshell/PluginModules.qml"
    # Nothing added or removed in a plugin folder since: as it is (the walk
    # below took ~0.15 s of the session's start).
    # (A stamp of its own: touching the file itself would reload the shell.)
    stamp="${XDG_CACHE_HOME:-$HOME/.cache}/nafeel-shell/plugin-modules.stamp"
    [ -f "$out" ] && [ -f "$stamp" ] && [ -z "$(find "$root/quickshell/plugins" -type d -newer "$stamp" -print -quit)" ] && return
    {
        echo "// Generated by bin/nafeel-shell at every start: one import per plugin"
        echo "// folder, so each is a Quickshell module. Edits here are overwritten."
        echo "import QtQuick"
        # Every plugin's folder and every folder in it with QML (a theme's),
        # in one walk (one per plugin cost ~0.2 s of the session's start).
        for f in "$root"/quickshell/plugins/*/plugin.json; do
            [ -f "$f" ] && dirname "$f"
        done | xargs -r -d '\n' sh -c 'find "$@" -name "*.qml" -printf "%h\n"' sh | sort -u | while read -r d; do
            rel=${d#"$root"/quickshell/}
            mod=$(printf '%s' "$rel" | tr / .)
            case "$mod" in *[!a-z0-9_.]*) echo "// skipped (not a module name): $rel"; continue ;; esac
            echo "import qs.$mod"
        done
        echo
        echo "QtObject {}"
    } >"$out.tmp"
    cmp -s "$out.tmp" "$out" && rm -f "$out.tmp" || mv -f "$out.tmp" "$out"
    mkdir -p "$(dirname "$stamp")" && touch "$stamp"
}

. "$root/bin/shell-env"

# The session's entrance (quickshell/plugins/lock/Entrance.qml: the login
# screen's grant carried on while the desktop loads): for the first shell of a
# umbriel session only, as it starts, never a restart.
# (NAFEEL_ENTRANCE=1 forces it, to measure a start.)
entrance=${NAFEEL_ENTRANCE:-0}
session=$(pgrep -nx umbriel)
if [ -n "$session" ] && [ "$(cat "$run/nafeel-shell.session" 2>/dev/null)" != "$session" ]; then
    echo "$session" >"$run/nafeel-shell.session"
    [ "$(ps -o etimes= -p "$session" | tr -d ' ')" -lt 60 ] 2>/dev/null && entrance=1
fi

while :; do
    plugin_modules
    start=$(date +%s)
    echo "starting quickshell"
    NAFEEL_ENTRANCE=$entrance QML_IMPORT_PATH="$root/native/build/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" quickshell -p "$root/quickshell" >"$run/nafeel-shell.log" 2>&1
    entrance=0
    echo "quickshell exited ($?)"
    # After a crash Quickshell starts a fresh copy of itself: while that one
    # runs, don't start another.
    while running; do sleep 2; done
    [ $(($(date +%s) - start)) -lt 10 ] && sleep 5
done
