#!/bin/sh
# The fallback lock: cave-abode's standalone Quickshell lock (quickshell/Lock.qml),
# kept from the retired nafeel/cave-abode Noctalia plugin. shell-msg runs it only
# when the shell isn't there to lock. One lock at a time (a second call while
# locked does nothing). The last run's log is in $CAVE_ABODE_STATE.
set -u
root="$(cd "$(dirname "$0")/.." && pwd)"
export CAVE_ABODE_STATE="${CAVE_ABODE_STATE:-$HOME/.local/state/nafeel-shell/lock}"
mkdir -p "$CAVE_ABODE_STATE"

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/cave-abode-lock.lock"
flock -n 9 || exit 0

command -v quickshell >/dev/null 2>&1 || exit 1
exec quickshell -p "$root/quickshell/Lock.qml" >"$CAVE_ABODE_STATE/lock.log" 2>&1
